# DeepSeek Web Token
# Obtain this from https://chat.deepseek.com:
# 1. Login to https://chat.deepseek.com
# 2. Press F12 -> Application tab -> Local Storage -> https://chat.deepseek.com
# 3. Copy the token from 'userToken' (or check Network tab -> Authorization: Bearer <token>)
DEEPSEEK_TOKEN=your_deepseek_token_here

# Server Configuration
PORT=18789
HOST=127.0.0.1

# Admin key for remote access to the dashboard / management API (/api/*).
# Requests from this machine (127.0.0.1) do not need it. If empty, a random key is
# generated and stored as "adminKey" in data/config.json.
ADMIN_KEY=

# Extra hostnames (comma separated) the dashboard may be opened under, besides
# localhost and plain IP addresses, e.g. proxy.example.com
ALLOWED_HOSTS=
